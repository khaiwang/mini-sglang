          <mxGeometry x="600" y="20" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="nnsight (Hook-based) vs mini-sglang (Buffer+Mask) vs Goodfire (Activation Collection)" style="text;html=1;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
