        </mxCell>

        <!-- mini-sglang output -->
        <mxCell id="m_output" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Modified logits + async observation pipeline to CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="720" width="620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m_arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="m_model_box" target="m_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- mini-sglang characteristics -->
        <mxCell id="m_chars" value="&lt;b&gt;Characteristics&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; CUDA graph compatible (no hooks, no dynamic dispatch)&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Per-request, per-layer granularity via req_map gather&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Multi-request batching with different interventions&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Both observe (read) AND blend (write) in same pass&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Async 3-stage pipeline (GPU obs -&gt; async D2H -&gt; CPU)&lt;br&gt;&lt;font color=&quot;#ffaa00&quot;&gt;&#x25CF;&lt;/font&gt; Fixed kernel launch overhead (~5-10us x 2 x num_layers)&lt;br&gt;&lt;font color=&quot;#ffaa00&quot;&gt;&#x25CF;&lt;/font&gt; Post-layer residual stream only (no sub-module access)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="780" width="620" height="140" as="geometry" />
        </mxCell>

