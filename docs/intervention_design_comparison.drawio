        <!-- Goodfire characteristics -->
        <mxCell id="g_chars" value="&lt;b&gt;Characteristics&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Optimized for massive throughput (bulk harvest)&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Async 3-stage pipeline overlaps GPU+CPU&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Pre-allocated fixed buffers (no dynamic alloc)&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Dedicated copy stream avoids compute stalls&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&#x2716;&lt;/font&gt; Read-only: no activation modification (no steer/ablate)&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&#x2716;&lt;/font&gt; Batch-level collection, not per-request granularity&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&#x2716;&lt;/font&gt; Not designed for online serving (offline batch job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1420" y="780" width="600" height="140" as="geometry" />
        </mxCell>

