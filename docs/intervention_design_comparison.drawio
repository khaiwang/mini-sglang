        <!-- COLUMN 3: Goodfire               -->
        <!-- =============================== -->

        <!-- Column header -->
        <mxCell id="col3_header" value="&lt;b&gt;Goodfire&lt;/b&gt;&lt;br&gt;Activation Collection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1420" y="110" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- Goodfire input -->
        <mxCell id="g_user" value="&lt;b&gt;Batch of Prompts&lt;/b&gt;&lt;br&gt;High-throughput bulk inference&lt;br&gt;Goal: harvest activations at scale for SAE training" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
