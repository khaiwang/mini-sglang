        </mxCell>

        <!-- User Code -->
        <mxCell id="n_user" value="&lt;b&gt;User Code&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;with model.trace(input):&lt;br&gt;&amp;nbsp; act = model.layers[L].output.save()&lt;br&gt;&amp;nbsp; model.layers[L].output[:] = steering_vec&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
