        <mxCell id="m_obsN" value="&lt;font color=&quot;#0066cc&quot;&gt;&lt;b&gt;observe()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
