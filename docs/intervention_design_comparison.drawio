        <mxCell id="m_blendN" value="&lt;font color=&quot;#009900&quot;&gt;&lt;b&gt;blend()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;1&quot; face=&quot;Courier New&quot;&gt;x*scale + add&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
