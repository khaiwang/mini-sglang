        </mxCell>

        <!-- Model Forward (observe only) -->
        <mxCell id="g_model_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="420" width="600" height="280" as="geometry" />
        </mxCell>
        <mxCell id="g_model_title" value="&lt;b&gt;Model Forward Pass&lt;/b&gt;" style="text;html=1;fontSize=12;fontFamily=Helvetica;align=center;fontColor=#7c5295;" vertex="1" parent="1">
          <mxGeometry x="1420" y="425" width="600" height="20" as="geometry" />
        </mxCell>

        <mxCell id="g_layer0" value="Layer 0 forward()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
