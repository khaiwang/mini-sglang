          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- nnsight characteristics -->
        <mxCell id="n_chars" value="&lt;b&gt;Characteristics&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&#x2716;&lt;/font&gt; Python callback per layer = GIL contention&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&#x2716;&lt;/font&gt; Not CUDA graph compatible (dynamic dispatch)&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&#x2716;&lt;/font&gt; Requires nn.Module (not compatible with BaseOP)&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&#x2716;&lt;/font&gt; Per-request hooks on shared model = concurrency issues&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Zero overhead when no hooks registered&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Fine-grained: any module, input or output&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;&#x2714;&lt;/font&gt; Flexible: arbitrary Python in callbacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="600" height="140" as="geometry" />
        </mxCell>

        <!-- =============================== -->
        <!-- COLUMN 2: mini-sglang            -->
        <!-- =============================== -->

        <!-- Column header -->
        <mxCell id="col2_header" value="&lt;b&gt;mini-sglang&lt;/b&gt;&lt;br&gt;Buffer+Mask Intervention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontFamily=Helvetica;verticalAlign=middle;align=center;" vertex="1" parent="1">
