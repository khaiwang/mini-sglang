        <!-- nnsight output -->
        <mxCell id="n_output" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Saved activations + modified output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
