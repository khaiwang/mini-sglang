        <mxCell id="n_trace" value="&lt;b&gt;Tracing Context Manager&lt;/b&gt;&lt;br&gt;Envoy proxies wrap nn.Module tree&lt;br&gt;Records operations as a computation graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
